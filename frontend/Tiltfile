load('../tiltlib.star', 'read_dotenv', 'detect_engine', 'run_flags', 'container_serve')

DOCKER = detect_engine()
FLAGS  = run_flags(DOCKER)

# browser TURN config comes from the root .env (single source; same vars coturn
# uses). dev runs `next dev`, so these are read from the runtime environment.
root_env = read_dotenv('../.env')

local_resource(
    'frontend',
    cmd=DOCKER + ' build -t frontend -f Dockerfile.dev .',
    serve_cmd=container_serve(DOCKER, FLAGS, 'frontend',
        '--network ft_transcendence ' +
        '--env-file .env ' +
        '-e WATCHPACK_POLLING=true ' +
        '-e NEXT_PUBLIC_TURN_URL=turn:' + root_env.get('TURN_REALM', '') + ':3478 ' +
        '-e NEXT_PUBLIC_TURN_USERNAME=' + root_env.get('TURN_USERNAME', '') + ' ' +
        '-e NEXT_PUBLIC_TURN_PASSWORD=' + root_env.get('TURN_PASSWORD', '') + ' ' +
        '-v $(pwd)/app:/app/app ' +
        '-v $(pwd)/src:/app/src ' +
        '-v $(pwd)/public:/app/public ' +
        '-v $(pwd)/next.config.js:/app/next.config.js ' +
        '-v $(pwd)/tailwind.config.ts:/app/tailwind.config.ts ' +
        '-v $(pwd)/postcss.config.js:/app/postcss.config.js ' +
        '-v $(pwd)/tsconfig.json:/app/tsconfig.json ' +
        'frontend'
    ),
    deps=['Dockerfile.dev', 'package.json'],
    resource_deps=['dev-network'],
    labels=['frontend'],
)

# Next.js can't listen on a unix socket, so socat bridges nginx's socket to it;
# the frontend has no host-published port (reached only through nginx).
local_resource(
    'frontend-socket',
    serve_cmd=container_serve(DOCKER, FLAGS, 'frontend-socket',
        '--network ft_transcendence ' +
        '-v frontend_socket:/run/frontend ' +
        'docker.io/alpine/socat UNIX-LISTEN:/run/frontend/frontend.sock,fork,mode=0666 TCP:frontend:3000'
    ),
    resource_deps=['frontend'],
    labels=['frontend'],
)
