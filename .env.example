#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     RabbitMQ credentials.                           │
#    │               ───── Example: guest / guest ─────                    │
#    ╰─────────────────────────────────────────────────────────────────────╯

RABBITMQ_USER=
RABBITMQ_PASS=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │              Root URL of the infra (gateway entry point).           │
#    │          ───── Example: https://localhost:1443 ─────                │
#    ╰─────────────────────────────────────────────────────────────────────╯

BASE_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                    Base URL for all API routes.                     │
#    │       ───── Example: https://localhost:1443/api ─────               │
#    ╰─────────────────────────────────────────────────────────────────────╯

BASE_API_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                      Shared JWT secret key.                         │
#    │   ───── Example: a-very-long-secret-key-at-least-32-chars ─────     │
#    ╰─────────────────────────────────────────────────────────────────────╯

JWT_SECRET=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │              MinIO (S3-compatible) object storage.                  │
#    │           ───── Example: minioadmin / minioadmin ─────              │
#    ╰─────────────────────────────────────────────────────────────────────╯

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chat-attachments
MINIO_USER_BUCKET=user-avatars
MINIO_GUILD_BUCKET=guild-icons
MINIO_EXPORTS_BUCKET=exports

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │            coturn (STUN/TURN) long-term credentials.                │
#    │   ───── Example: localhost / ft_turn / a-long-random-secret ─────   │
#    ╰─────────────────────────────────────────────────────────────────────╯

TURN_REALM=
TURN_USERNAME=
TURN_PASSWORD=
# optional: force the IPv4 the TURN relay advertises (must be reachable by the
# other device, e.g. your LAN IP like 192.168.1.52). leave blank to auto-detect
# the host's primary LAN address from its default route
TURN_RELAY_IP=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │              Grafana admin login (monitoring dashboard).            │
#    │               ───── Example: admin / admin ─────                    │
#    ╰─────────────────────────────────────────────────────────────────────╯

# optional: both default to "admin" if left blank. Grafana is reachable only via
# nginx TLS at https://localhost:1443/grafana.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
