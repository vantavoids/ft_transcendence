      "pluginVersion": "11.3.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pg_stat_database_numbackends", "legendFormat": "{{instance}} / {{datname}}", "refId": "A" }],
