      "pluginVersion": "11.3.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pg_stat_database_blks_hit[5m])) by (instance) / (sum(rate(pg_stat_database_blks_hit[5m])) by (instance) + sum(rate(pg_stat_database_blks_read[5m])) by (instance))", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Cache hit ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
