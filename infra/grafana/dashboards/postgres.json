        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pg_stat_database_tup_fetched[5m])) by (instance)", "legendFormat": "{{instance}} fetched", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(pg_stat_database_tup_inserted[5m])) by (instance)", "legendFormat": "{{instance}} inserted", "refId": "C" },
