      "pluginVersion": "11.3.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(pg_stat_database_deadlocks)", "refId": "A" }],
      "title": "Deadlocks (cumulative)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
