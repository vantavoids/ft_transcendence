#    ╭───────────────────────────────────────────────────────────────────────╮
#    │                        PostgreSQL credentials.                        │
#    │    POSTGRES_* configure the postgres container. The app binds the     │
#    │   Database section via the Options pattern, so the same values are    │
#    │      repeated as Database__* below: Compose ${...} interpolation      │
#    │     cannot read a service env_file, so they must be literal here.     │
#    │    Host/Port topology lives in compose.yaml / Tiltfile, not here.     │
#    │              ----- Example: guild / guild / guild -----               │
#    ╰───────────────────────────────────────────────────────────────────────╯

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

Database__Name=
Database__User=
Database__Password=

#    ╭───────────────────────────────────────────────────────────────────────╮
#    │                        Snowflake ID generator.                        │
#    │      WorkerId 2 is reserved for the Guild Service (Auth uses 1).      │
#    │    Defaults are applied in code; set Snowflake__WorkerId here only    │
#    │                       if you want to override.                        │
#    ╰───────────────────────────────────────────────────────────────────────╯

Snowflake__WorkerId=2

#    ╭───────────────────────────────────────────────────────────────────────╮
#    │                         MinIO object storage.                         │
#    │       Minio__Endpoint is the in-cluster URL of the shared MinIO       │
#    │       service. The AccessKey / SecretKey / Bucket are wired in        │
#    │              compose.yaml / Tiltfile from the root .env.              │
#    │                ----- Example: http://minio:9000 -----                 │
#    ╰───────────────────────────────────────────────────────────────────────╯

Minio__Endpoint=
