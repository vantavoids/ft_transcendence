#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     PostgreSQL credentials.                         │
#    │   Used both by the postgres container (POSTGRES_*) and forwarded    │
#    │   into the service via Database__User / Database__Password by       │
#    │   compose.yaml. The connection itself is bound through the Options  │
#    │   pattern (Database section) — no connection string lives in env.   │
#    │         ───── Example: guild / guild / guild ─────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                        JWT validation.                              │
#    │   Jwt__SecretKey is wired in compose.yaml / Tiltfile from the root  │
#    │   .env's JWT_SECRET (same shared secret as the Auth Service).       │
#    │   This service only validates tokens (signature + expiry); it       │
#    │   never issues them.                                                │
#    ╰─────────────────────────────────────────────────────────────────────╯

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                       Snowflake ID generator.                       │
#    │   WorkerId 2 is reserved for the Guild Service (Auth uses 1).       │
#    │   Defaults are applied in code; set Snowflake__WorkerId here only   │
#    │   if you want to override.                                          │
#    ╰─────────────────────────────────────────────────────────────────────╯
