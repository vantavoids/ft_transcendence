{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "auth-service",
    "Audience": "transcendence-api",
    "AccessTokenTtlMinutes": 15
  },
  "RefreshToken": {
    "TtlDays": 7,
    "ByteLength": 64,
    "CookieName": "refresh_token",
    "HttpOnly": true,
    "Secure": true
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Frontend": {
    "BaseUrl": ""
  }
}
