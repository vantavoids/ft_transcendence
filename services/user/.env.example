#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     PostgreSQL credentials.                         │
#    │       ───── Example: user_user / my_password / user_db ─────        │
#    ╰─────────────────────────────────────────────────────────────────────╯

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                  SQLx full PostgreSQL connection URL.               │
#    │    ── Example: postgres://user:password@user-db:5432/user_db ──     │
#    ╰─────────────────────────────────────────────────────────────────────╯

DATABASE_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     Shared JWT secret key.                          │
#    │   ───── Example: a-very-long-secret-key-at-least-32-chars ─────     │
#    ╰─────────────────────────────────────────────────────────────────────╯

JWT_SECRET=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     RabbitMQ credentials.                           │
#    │               ───── Example: user / password ─────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

RABBITMQ_USER=
RABBITMQ_PASS=
