#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     PostgreSQL credentials.                         │
#    │       ───── Example: user_user / my_password / user_db ─────        │
#    ╰─────────────────────────────────────────────────────────────────────╯

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                  SQLx full PostgreSQL connection URL.               │
#    │    ── Example: postgres://user:password@user-db:5432/user_db ──     │
#    ╰─────────────────────────────────────────────────────────────────────╯

DATABASE_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     Shared JWT secret key.                          │
#    │   ───── Example: a-very-long-secret-key-at-least-32-chars ─────     │
#    ╰─────────────────────────────────────────────────────────────────────╯

JWT_SECRET=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │              Public gateway base URL for returned media URLs.       │
#    │            ───── Example: https://localhost:1443 ─────              │
#    ╰─────────────────────────────────────────────────────────────────────╯

BASE_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     MinIO object storage.                           │
#    │      ───── Example: http://minio:9000 / minioadmin / user-avatars ─────
#    ╰─────────────────────────────────────────────────────────────────────╯

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USER_BUCKET=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     RabbitMQ credentials.                           │
#    │               ───── Example: user / password ─────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

RABBITMQ_USER=
RABBITMQ_PASS=
