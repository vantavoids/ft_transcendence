load('../../tiltlib.star', 'read_dotenv', 'detect_engine', 'run_flags', 'container_serve')

root_env = read_dotenv('../../.env')

DOCKER = detect_engine()
FLAGS  = run_flags(DOCKER)

local_resource(
    'user-db',
    serve_cmd=container_serve(DOCKER, FLAGS, 'user-db',
        '--network ft_transcendence ' +
        '--env-file .env ' +
        '-v user_db_data:/var/lib/postgresql/data ' +
        'docker.io/postgres:17-alpine'
    ),
    resource_deps=['dev-network'],
    labels=['user'],
)

local_resource(
    'user',
    cmd=DOCKER + ' build -t user-service -f Dockerfile.dev .',
    serve_cmd=container_serve(DOCKER, FLAGS + '--init ', 'user',
        '--network ft_transcendence ' +
        '--env-file .env ' +
        '-e APP_ENV=development ' +
        '-e RABBITMQ_USER=' + root_env.get('RABBITMQ_USER', 'user') + ' ' +
        '-e RABBITMQ_PASS=' + root_env.get('RABBITMQ_PASS', 'password') + ' ' +
        '-e JWT_SECRET=' + root_env.get('JWT_SECRET', '') + ' ' +
        '-v $(pwd)/src:/app/src ' +
        '-v $(pwd)/package.json:/app/package.json ' +
        '-v $(pwd)/tsconfig.json:/app/tsconfig.json ' +
        '-v $(pwd)/tsconfig.build.json:/app/tsconfig.build.json ' +
        'user-service npm run start:dev'
    ),
    deps=['Dockerfile.dev', 'Dockerfile', 'package.json', 'tsconfig.json', 'tsconfig.build.json'],
    resource_deps=['user-db'],
    labels=['user'],
)
