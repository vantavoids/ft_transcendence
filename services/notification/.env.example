#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                    Port used by the service.                        │
#    │                 ───────── Example: 8080 ──────────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

APP_PORT=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                     PostgreSQL credentials.                         │
#    │  ── Example: notification_user / my_password / notification_db ──   │
#    ╰─────────────────────────────────────────────────────────────────────╯

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │               Prisma / full PostgreSQL connection URL.              │
#    │  ── Example: postgresql://user:password@notification-db:5432/db ── │
#    ╰─────────────────────────────────────────────────────────────────────╯

DATABASE_URL=
