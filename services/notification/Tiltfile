load('../../tiltlib.star', 'read_dotenv', 'detect_engine', 'run_flags', 'container_serve')

root_env         = read_dotenv('../../.env')
notif_env        = read_dotenv('.env')
MQ_USER          = root_env.get('RABBITMQ_USER', 'notification_user')
MQ_PASS          = root_env.get('RABBITMQ_PASS', 'my_password')
JWT_SECRET       = root_env.get('JWT_SECRET', '')
USER_SERVICE_URL = root_env.get('USER_SERVICE_URL', 'http://user:8000')
BASE_API_URL     = root_env.get('BASE_API_URL', 'https://localhost:1443/api')
PG_USER          = notif_env.get('POSTGRES_USER', 'notification')
PG_PASS          = notif_env.get('POSTGRES_PASSWORD', 'notification')
PG_DB            = notif_env.get('POSTGRES_DB', 'notification')
APP_PORT         = notif_env.get('APP_PORT', '8080')
DATABASE_URL     = 'postgres://' + PG_USER + ':' + PG_PASS + '@notification-db:5432/' + PG_DB

DOCKER = detect_engine()
FLAGS  = run_flags(DOCKER)

local_resource(
    'notification-db',
    serve_cmd=container_serve(DOCKER, FLAGS, 'notification-db',
        '--network ft_transcendence ' +
        '-p 127.0.0.1:5444:5432 ' +
        '--env-file .env ' +
        '-v notification_db_data:/var/lib/postgresql/data ' +
        'docker.io/postgres:17-alpine'
    ),
    resource_deps=['dev-network'],
    labels=['notification'],
)

local_resource(
    'notification-migrate',
    cmd=(
        DOCKER + ' build -t notification-migrate-service -f Dockerfile.migrate . && ' +
        DOCKER + ' rm -f notification-migrate 2>/dev/null; ' +
        DOCKER + ' run ' + FLAGS + '--name notification-migrate --rm ' +
        '--network ft_transcendence ' +
        '--env-file .env ' +
        'notification-migrate-service'
    ),
    deps=['Dockerfile.migrate', 'db/migrations'],
    resource_deps=['notification-db'],
    labels=['notification'],
)

local_resource(
    'notification',
    cmd=DOCKER + ' build -t notification-service -f Dockerfile.dev .',
    serve_cmd=container_serve(DOCKER, FLAGS, 'notification',
        '--network ft_transcendence ' +
        '--env-file .env ' +
        '-e NOTIFICATION_DEV=true ' +
        '-e APP_PORT=' + APP_PORT + ' ' +
        '-e JWT_SECRET=' + JWT_SECRET + ' ' +
        '-e RABBITMQ_USER=' + MQ_USER + ' ' +
        '-e RABBITMQ_PASS=' + MQ_PASS + ' ' +
        '-e USER_SERVICE_URL=' + USER_SERVICE_URL + ' ' +
        '-e BASE_API_URL=' + BASE_API_URL + ' ' +
        '-e DATABASE_URL=' + DATABASE_URL + ' ' +
        '-v $(pwd):/app ' +
        'notification-service'
    ),
    deps=['Dockerfile.dev', 'go.mod', 'go.sum'],
    resource_deps=['notification-db', 'notification-migrate', 'rabbitmq'],
    labels=['notification'],
)