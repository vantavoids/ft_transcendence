#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                          JWT secret value.                          │
#    │                 ───── Example: HelloWorld123 ─────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

JWT_SECRET=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                      Port used by the gateway.                      │
#    │                 ───────── Example: 8000 ──────────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

GATEWAY_PORT=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                       Services url and ports.                       │
#    │                ───── Example: http://auth:8000 ─────                │
#    ╰─────────────────────────────────────────────────────────────────────╯

AUTH_SERVICE_URL=
CHAT_SERVICE_URL=
GUILD_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
USER_SERVICE_URL=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │             Rate limiting per UID. Values must be > 0.              │
#    │    ───────────────── Fill rate/s. Example: 1.0 ─────────────────    │
#    │    ───────────────── Bucket size. Example: 10 ──────────────────    │
#    │    ───── Max idle before cleaning limiter/min. Example: 15 ─────    │
#    ╰─────────────────────────────────────────────────────────────────────╯

UID_RATE=
UID_BUCKET=
UID_MAX_IDLE=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │              Rate limiting per IP. Values must be > 0.              │
#    │    ──────────────── Fill rate/s. Example: 0.2 ─────────────────     │
#    │    ───────────────── Bucket size. Example: 3 ──────────────────     │
#    │    ───── Max idle before cleaning limiter/min. Example: 5 ─────     │
#    ╰─────────────────────────────────────────────────────────────────────╯

IP_RATE=
IP_BUCKET=
IP_MAX_IDLE=

#    ╭─────────────────────────────────────────────────────────────────────╮
#    │                          Dev environment.                           │
#    │                         Debug logs toggle.                          │
#    │                 ───────── Example: true ──────────                  │
#    │                 ───────── Example: true ──────────                  │
#    ╰─────────────────────────────────────────────────────────────────────╯

GATEWAY_DEV=
GATEWAY_DEBUG=
