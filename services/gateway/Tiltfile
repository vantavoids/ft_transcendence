load('../../tiltlib.star', 'detect_engine', 'read_dotenv', 'run_flags', 'container_serve')

root_env = read_dotenv('../../.env')
JWT_SECRET   = root_env.get('JWT_SECRET', '')

DOCKER   = detect_engine()
FLAGS    = run_flags(DOCKER)

local_resource(
    'gateway',
    cmd=DOCKER + ' build -t gateway-service -f Dockerfile.dev .',
    serve_cmd=container_serve(DOCKER, FLAGS, 'gateway',
        '--network ft_transcendence ' +
        '--env-file .env ' +
		'-p 127.0.0.1:8080:8080 ' +
        '-e JWT_SECRET=' + JWT_SECRET + ' ' +
        '-e GATEWAY_DEV=true ' +
        '-v $(pwd):/app ' +
        'gateway-service'
    ),
    deps=['Dockerfile.dev', 'go.mod', 'go.sum'],
    resource_deps=['auth', 'chat', 'guild', 'notification', 'user'],
    labels=['gateway'],
)
